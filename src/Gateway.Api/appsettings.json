{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "dev-jwt-secret-change-me-32chars-min",
    "Issuer": "job-platform",
    "Audience": "job-platform",
    "ExpiresMinutes": 60
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": { "Path": "/api/auth/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/auth/{**catch-all}" }]
      },
      "health-auth": {
        "ClusterId": "auth",
        "Match": { "Path": "/health/auth" },
        "Transforms": [{ "PathPattern": "/health" }]
      },
      "search": {
        "ClusterId": "search",
        "Match": { "Path": "/api/search/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/search/{**catch-all}" }]
      },
      "jobs": {
        "ClusterId": "job",
        "Match": { "Path": "/api/jobs/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/jobs/{**catch-all}" }]
      },
      "categories": {
        "ClusterId": "job",
        "Match": { "Path": "/api/categories/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/categories/{**catch-all}" }]
      },
      "companies": {
        "ClusterId": "job",
        "Match": { "Path": "/api/companies/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/companies/{**catch-all}" }]
      },
      "jobs-create": {
        "ClusterId": "job",
        "AuthorizationPolicy": "Recruiter",
        "Match": { "Path": "/api/jobs", "Methods": ["POST"] }
      },
      "jobs-recruiter": {
        "ClusterId": "job",
        "AuthorizationPolicy": "Recruiter",
        "Match": { "Path": "/api/jobs/recruiter", "Methods": ["GET"] }
      },
      "jobs-recommended": {
        "ClusterId": "job",
        "AuthorizationPolicy": "User",
        "Match": { "Path": "/api/jobs/recommended", "Methods": ["GET"] }
      },
      "jobs-write": {
        "ClusterId": "job",
        "AuthorizationPolicy": "Recruiter",
        "Match": { "Path": "/api/jobs/{id:guid}", "Methods": ["PUT", "DELETE"] }
      },
      "companies-create": {
        "ClusterId": "job",
        "AuthorizationPolicy": "Recruiter",
        "Match": { "Path": "/api/companies", "Methods": ["POST"] }
      },
      "companies-update": {
        "ClusterId": "job",
        "AuthorizationPolicy": "Recruiter",
        "Match": { "Path": "/api/companies/{id:guid}", "Methods": ["PUT"] }
      },
      "admin-users": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "Admin",
        "Match": { "Path": "/api/admin/users/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/admin/users/{**catch-all}" }]
      },
      "admin-stats": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "Admin",
        "Match": { "Path": "/api/admin/stats" },
        "Transforms": [{ "PathPattern": "/api/admin/stats" }]
      },
      "admin-jobs": {
        "ClusterId": "job",
        "AuthorizationPolicy": "Admin",
        "Match": { "Path": "/api/admin/jobs/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/admin/jobs/{**catch-all}" }]
      },
      "app-status-flow": {
        "ClusterId": "app",
        "Match": { "Path": "/api/applications/status-flow" },
        "Transforms": [{ "PathPattern": "/api/applications/status-flow" }]
      },
      "apps-apply": {
        "ClusterId": "app",
        "AuthorizationPolicy": "User",
        "Match": { "Path": "/api/applications", "Methods": ["POST"] }
      },
      "apps-me": {
        "ClusterId": "app",
        "AuthorizationPolicy": "User",
        "Match": { "Path": "/api/applications/me", "Methods": ["GET"] }
      },
      "apps": {
        "ClusterId": "app",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/applications/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/applications/{**catch-all}" }]
      },
      "public-profile": {
        "ClusterId": "profile",
        "Match": { "Path": "/api/profiles/{userId:guid}", "Methods": ["GET"] },
        "Transforms": [{ "PathPattern": "/api/profiles/{userId}" }]
      },
      "profiles": {
        "ClusterId": "profile",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/profiles/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/profiles/{**catch-all}" }]
      },
      "notifications": {
        "ClusterId": "notif",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/notifications/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/notifications/{**catch-all}" }]
      },
      "ai": {
        "ClusterId": "ai",
        "AuthorizationPolicy": "Authenticated",
        "Match": { "Path": "/api/ai/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/ai/{**catch-all}" }]
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "auth1": { "Address": "http://localhost:5001" }
        }
      },
      "search": {
        "Destinations": {
          "search1": { "Address": "http://localhost:5003" }
        }
      },
      "job": {
        "Destinations": {
          "job1": { "Address": "http://localhost:5002" }
        }
      },
      "app": {
        "Destinations": {
          "app1": { "Address": "http://localhost:5004" }
        }
      },
      "profile": {
        "Destinations": {
          "profile1": { "Address": "http://localhost:5005" }
        }
      },
      "notif": {
        "Destinations": {
          "notif1": { "Address": "http://localhost:5006" }
        }
      },
      "ai": {
        "Destinations": {
          "ai1": { "Address": "http://localhost:6000" }
        }
      }
    }
  }
}
