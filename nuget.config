<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- GitHub Packages requires authentication even for reads. The token is read from the
         GITHUB_TOKEN environment variable (GITHUB_TOKEN in Actions, or a PAT with read:packages locally).
         Never commit a token value here. -->
    <add key="github-dut-pbl6-2026" value="https://nuget.pkg.github.com/dut-pbl6-2026/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github-dut-pbl6-2026>
      <add key="Username" value="USERNAME" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github-dut-pbl6-2026>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="github-dut-pbl6-2026">
      <package pattern="JobPlatform.SharedKernel" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
